{
  "name": "@synapxlab/ladder-timeline",
  "version": "0.1.1",
  "description": "Multi-scale temporal carousel — drag/zoom across 16 scales from billion-years to milliseconds. Markers, keyboard, pinch. Zero runtime dependency, TypeScript + SCSS.",
  "type": "module",
  "main": "./dist/ladder-timeline.umd.cjs",
  "module": "./dist/ladder-timeline.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ladder-timeline.es.js",
      "require": "./dist/ladder-timeline.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "README.fr.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "tsc --noEmit && vite build --config vite.lib.config.ts && tsc --declaration --emitDeclarationOnly --outDir dist",
    "preview": "vite preview",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "timeline",
    "carousel",
    "scale",
    "zoom",
    "temporal",
    "geological-time",
    "logarithmic",
    "drag",
    "typescript",
    "zero-dependency"
  ],
  "author": "synapxLab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/synapxLab/LadderTimeline"
  },
  "bugs": {
    "url": "https://github.com/synapxLab/LadderTimeline/issues"
  },
  "homepage": "https://github.com/synapxLab/LadderTimeline#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "jsdom": "^29.1.1",
    "sass": "^1.77.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^4.1.6"
  }
}
