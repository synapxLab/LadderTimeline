# ─── ChronoMap server — local config ──────────────────────────────────────
# Copier en `.env` (non versionné) et adapter au besoin.
#   cp server/.env.example server/.env

APP_ENV=local
APP_DEBUG=true

# PostgreSQL (local — change le mot de passe avant tout déploiement public)
DB_DSN="pgsql:host=127.0.0.1;port=5432;dbname=chronomap"
DB_USER="chronomap"
DB_PASS="j!1BIq9/aoQYig54"

# JWT — réutilise la clé partagée du keyring Synapx en prod ;
# en local on peut garder une clé HS256 dédiée.
JWT_SECRET="change-me-locally"
JWT_ALG="HS256"

# Frontend dev server (CORS allowlist, séparé par virgule)
CORS_ORIGINS="http://localhost:5173,http://chronomap.fr.lan"
